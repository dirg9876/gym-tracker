# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Local tool caches
.cache/
.local/

# Local environment files (use .env.example as the template).
# Ignore every .env* variant (.env, .env.local, .env.development,
# .env.production, …) and only allow the committed template through.
.env*
!.env.example

# Private AI gateway ledger and owner credentials.
.coach-data/
.wrangler/
.dev.vars*
.cloud-deploy/

# Local native builds, signing material and test exports are not source.
.expo-export-test/
*.keystore
*.jks
credentials.json
/attached_assets/*.tar.gz.part-*
/artifacts/android-avd/
/artifacts/android-downloads/
/artifacts/android-sdk/
/artifacts/android-tools/
/artifacts/apk/
/artifacts/gym-tracker-mobile/android/
/artifacts/gym-tracker-mobile/ios/
