{
  "name": "@workspace/api-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "coach": "node --env-file-if-exists=.env.coach --experimental-strip-types src/coach/index.ts",
    "test:coach": "node --test scripts/coach-*.test.mjs",
    "dev": "pnpm run coach",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@workspace/ai-coach": "workspace:*",
    "openai": "7.32.0",
    "zod": "catalog:",
    "express": "^5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "^0.27.3"
  }
}
