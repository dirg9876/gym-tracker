{
  "expo": {
    "name": "Gym-Beam",
    "slug": "gym-tracker-mobile",
    "version": "1.1.16",
    "runtimeVersion": "1.1.0",
    "updates": {
      "url": "https://u.expo.dev/dabd3128-415f-4a2f-8c73-3b0a52585149",
      "requestHeaders": {
        "expo-channel-name": "production"
      },
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/images/gymbeam-icon.png",
    "scheme": "gym-tracker-mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/gymbeam-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "backgroundColor": "#0a0a0a",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.dirg9876.gymtracker",
      "versionCode": 22,
      "backgroundColor": "#0a0a0a",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/gymbeam-adaptive.png",
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "favicon": "./assets/images/gymbeam-icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      "./plugins/withCoachSecureStorage.cjs",
      "./plugins/withCoachNetworkSecurity.cjs",
      "./plugins/withWindowsNativePaths.cjs"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "dabd3128-415f-4a2f-8c73-3b0a52585149"
      }
    },
    "owner": "dirg9508"
  }
}
